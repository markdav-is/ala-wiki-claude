<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <Product>AlaWiki.Module.MindMap</Product>
    <Authors>AlaWiki</Authors>
    <Description>Mind-mapping extension for Azure DevOps wikis</Description>
    <Copyright>AlaWiki</Copyright>
    <AssemblyName>AlaWiki.Module.MindMap.Shared.Oqtane</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
