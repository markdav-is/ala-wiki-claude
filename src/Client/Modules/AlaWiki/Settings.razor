@using Oqtane.Modules
@using AlaWiki.Shared.Models
@namespace AlaWiki.Client.Modules.AlaWiki
@inherits ModuleBase
@inject ISettingService SettingService

<div class="container-fluid">
    <h4>Mind Map Display Settings</h4>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Layout Direction</label>
                <select class="form-select" @bind="_settings.LayoutDirection">
                    <option value="right">Left to Right</option>
                    <option value="down">Top to Bottom</option>
                    <option value="radial">Radial</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Theme</label>
                <select class="form-select" @bind="_settings.Theme">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="colorful">Colorful</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Maximum Depth</label>
                <input type="number" class="form-control" @bind="_settings.MaxDepth" min="1" max="20" />
                <div class="form-text">Maximum levels to display (1-20)</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Node Spacing X</label>
                <input type="number" class="form-control" @bind="_settings.NodeSpacingX" min="50" max="500" />
            </div>

            <div class="mb-3">
                <label class="form-label">Node Spacing Y</label>
                <input type="number" class="form-control" @bind="_settings.NodeSpacingY" min="20" max="200" />
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="showCrossRefs" @bind="_settings.ShowCrossReferences" />
                <label class="form-check-label" for="showCrossRefs">Show Cross-Reference Links</label>
            </div>
        </div>
    </div>
</div>

@code {
    private MindMapSettings _settings = new();
    private Dictionary<string, string> _moduleSettings = new();

    protected override async Task OnInitializedAsync()
    {
        _moduleSettings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);

        _settings = new MindMapSettings
        {
            LayoutDirection = GetSetting("LayoutDirection", "right"),
            Theme = GetSetting("Theme", "light"),
            MaxDepth = int.Parse(GetSetting("MaxDepth", "10")),
            NodeSpacingX = int.Parse(GetSetting("NodeSpacingX", "200")),
            NodeSpacingY = int.Parse(GetSetting("NodeSpacingY", "50")),
            ShowCrossReferences = bool.Parse(GetSetting("ShowCrossReferences", "true"))
        };
    }

    private string GetSetting(string key, string defaultValue)
    {
        return _moduleSettings.TryGetValue($"AlaWiki_{key}", out var value) ? value : defaultValue;
    }

    public async Task UpdateSettings()
    {
        var settings = new Dictionary<string, string>
        {
            { "AlaWiki_LayoutDirection", _settings.LayoutDirection },
            { "AlaWiki_Theme", _settings.Theme },
            { "AlaWiki_MaxDepth", _settings.MaxDepth.ToString() },
            { "AlaWiki_NodeSpacingX", _settings.NodeSpacingX.ToString() },
            { "AlaWiki_NodeSpacingY", _settings.NodeSpacingY.ToString() },
            { "AlaWiki_ShowCrossReferences", _settings.ShowCrossReferences.ToString() }
        };

        await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
    }
}
